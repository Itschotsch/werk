#!/usr/bin/env bash
set -e

echo "======================================="
echo "Running Werk Monorepo Pre-Commit Checks"
echo "======================================="

# 1. Format Check
echo ""
echo "[1/3] Checking code formatting (Prettier)..."
npm run format:check

# 2. Type Check (Strict)
echo ""
echo "[2/3] Checking types (tsc & svelte-check)..."
npm run typecheck

# 3. Strict Linting
echo ""
echo "[3/3] Running strict linter (ESLint with zero warnings tolerated)..."
npm run lint

echo ""
echo "============================================="
echo "✅ All pre-commit checks passed successfully!"
echo "============================================="
